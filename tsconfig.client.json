{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client", "@cloudflare/workers-types"]
  },
  "include": ["src/client/**/*.js", "src/client/**/*.jsx", "src/client/**/*.d.ts"]
}
