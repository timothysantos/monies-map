{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monies-map",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-03",
  "preview_urls": false,
  "vars": {
    "SHORTCUT_PUBLIC_ENDPOINT": "https://monies-map-shortcuts.timsantos-accts.workers.dev/api/shortcuts/entries/create",
    "AI_ASSIST_ENABLED": "true",
    "AI_ASSIST_DAILY_LIMIT": "40",
    "AI_GATEWAY_ACCOUNT_ID": "f36beb0fea34ebd370af7911d073c767",
    "AI_GATEWAY_ID": "monies-map",
    "AI_GATEWAY_BYOK_ALIAS": "monies-map-claude-api-key",
    "AI_ALERT_EMAILS": "*"
  },
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "monies-map",
      "database_id": "d1aa440c-d239-48ac-b0a6-d39f34e26e0e"
    }
  ],
  "observability": {
    "enabled": true
  }
}
