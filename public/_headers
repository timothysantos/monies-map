# Cloudflare static asset headers (copied into dist by Vite).
# The page is always revalidated, so a deploy shows up on the next visit;
# hashed files never change under their name, so they are kept.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
